.git
.github
.pytest_cache
__pycache__
**/__pycache__/
*.pyc
**/*.pyc

config.json
config/
# Canonical template must reach the image build (copied to /app/config.template.json).
!config/config.template.json
runtime-state.json
data/
*.log
*.sqlite
*.sqlite-wal
*.sqlite-shm

tests/
scripts/
# Keep the one runtime dependency of ems/history (Analytics influx sync/status).
!scripts/influx_utils.py
# Admin builds generate the embedded release bundle from this repository tool.
!scripts/generate_release_resources.py
# On-hardware MQTT write-latency probe (developer tool; see docs/developer).
!scripts/mqtt_write_latency_probe.py
tasks/
docs/develop/
runtime-traces/
CODEX_AGENT_GUIDE.md

.agents/
.codex/
.claude/
CLAUDE.md
CLAUDE.local.md

# Local secrets, credentials and runtime backups (may contain secrets). The
# repository may be built from a real working installation, not only a clean
# GitHub checkout, so these must be excluded even though the broad rules above
# already cover config/ and data/.
.env
.env.*
backup/
deploy/docker/influxdb.env
deploy/docker/data/

# Local virtualenvs, Node modules and browser/test artifacts.
.venv/
venv/
node_modules/
reports/
playwright-report/
blob-report/
.playwright/
test-results/

# Tooling caches and coverage output.
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/
*.db
