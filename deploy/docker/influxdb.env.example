# Example environment for the optional InfluxDB 2.x analytics backend.
# Copy to influxdb.env (same directory) and replace the change-me values.
#
#   cp deploy/docker/influxdb.env.example deploy/docker/influxdb.env
#
# influxdb.env is gitignored. Never commit real tokens or passwords.

# --- Connection used by the EMS / emsctl (must match config.json influxdb.*) ---
# Org and token the EMS uses to read/write history. INFLUXDB_TOKEN is read by
# emsctl/the dashboard via influxdb.token_env in config.json.
INFLUXDB_ORG=ems
INFLUXDB_TOKEN=change-me-token

# --- Docker first-start bootstrap (applied only on an empty data volume) ---
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-password
# Admin token created on first start. For a simple single-token setup keep this
# equal to INFLUXDB_TOKEN above; create a scoped API token later if you prefer.
INFLUXDB_ADMIN_TOKEN=change-me-token
# Initial bucket created on first start. emsctl influx sync creates the rest
# ({bucket_prefix}_1m, _5m, _1h) from config.json. Keep this equal to
# "{bucket_prefix}_raw" (default bucket_prefix is "ems").
INFLUXDB_INIT_BUCKET=ems_raw
