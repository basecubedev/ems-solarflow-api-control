# Example environment for the optional InfluxDB 2.x analytics backend.
#
# You usually do NOT need to edit this by hand. The recommended zero-config
# path generates deploy/docker/influxdb.env with secure random secrets for you:
#
#   # in config.json set influxdb.enabled=true (mode stays "bundled")
#   python3 emsctl.py stack up        # or: python3 emsctl.py influx init
#
# To set it up manually instead, copy this file and replace the change-me
# values with strong secrets:
#
#   cp deploy/docker/influxdb.env.example deploy/docker/influxdb.env
#
# influxdb.env is gitignored. Never commit real tokens or passwords.
#
# All values are read directly by docker compose (env_file) and the EMS, so no
# ${...} interpolation is involved.

# --- Connection used by the EMS / emsctl (must match config.json influxdb.*) ---
# Org and the API token the EMS uses to read/write history. INFLUXDB_TOKEN is
# read by EMS/emsctl/the dashboard via influxdb.token_env in config.json.
INFLUXDB_ORG=ems
INFLUXDB_TOKEN=change-me-token

# --- Docker first-start bootstrap (applied only on an empty data volume) ---
# Changing these after first start does NOT re-initialize an existing database.
DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=change-me-password
DOCKER_INFLUXDB_INIT_ORG=ems
# Initial bucket created on first start. emsctl influx sync creates the rest
# ({bucket_prefix}_1m, _5m, _1h) from config.json. Keep this equal to
# "{bucket_prefix}_raw" (default bucket_prefix is "ems").
DOCKER_INFLUXDB_INIT_BUCKET=ems_raw
# Admin token created on first start. For a simple single-token setup keep this
# equal to INFLUXDB_TOKEN above; create a scoped API token later if you prefer.
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=change-me-token
