GRAFANA_HTTP_PORT=3001
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana

# InfluxDB2 development datasource
# If Grafana runs on the same Docker host as develop/influxdb and both are
# attached to the same Docker network, this can later be changed to a container
# hostname. Keep it configurable for local development.
GRAFANA_INFLUXDB_URL=http://host.docker.internal:8086
GRAFANA_INFLUXDB_ORG=zendure-dev
GRAFANA_INFLUXDB_BUCKET=zendure_raw
GRAFANA_INFLUXDB_TOKEN=change-me-admin
