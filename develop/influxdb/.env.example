INFLUXDB_URL=http://localhost:8086
INFLUXDB_ORG=zendure-dev
INFLUXDB_BUCKET_RAW=zendure_raw
INFLUXDB_BUCKET_1M=zendure_1m
INFLUXDB_BUCKET_15M=zendure_15m

# API token used by Python scripts.
# For the simple local development setup, keep this equal to
# INFLUXDB_ADMIN_TOKEN unless you intentionally create a separate API token.
INFLUXDB_TOKEN=change-me-admin

# InfluxDB UI/admin bootstrap values used only by Docker first-start setup.
INFLUXDB_ADMIN_USER=admin
INFLUXDB_ADMIN_PASSWORD=change-me-password
INFLUXDB_ADMIN_TOKEN=change-me-admin
