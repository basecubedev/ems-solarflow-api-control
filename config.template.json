{
  "_comment": "Copy this file to config.json and adjust your local setup.",
  "_comment_docs": "Detailed configuration guide and examples: docs/configuration.md and docs/configuration-examples.md",

  "ha": {
    "_comment": "Optional Home Assistant integration. Set enabled=false if you run EMS standalone.",
    "enabled": true,
    "control_enabled": true,
    "url": "http://homeassistant.local:8123",
    "token": "YOUR_TOKEN_HERE"
  },

  "system": {
    "_comment": "Global EMS settings and safety flags. Start with dry_run=true.",
    "enabled": true,
    "dry_run": true,
    "simulation_mode": false,
    "allow_hardware_writes": false,
    "allow_state_reconciliation_writes": false,
    "reconcile_ac_mode_on_start": true,
    "reconcile_smart_mode": true,
    "log_level": "info",
    "max_total_power": 800,
    "max_device_power": 800,
    "deadband": 10,
    "runtime_state_path": "runtime-state.json",
    "min_output_limit": 35,
    "loop_interval": 3,
    "output_control": {
      "_comment_output_control": "Advanced output smoothing/tuning. Most users should keep the defaults.",
      "load_deadband_w": 5,
      "target_deadband_w": 10,
      "filter_enabled": true,
      "filter_method": "median_ema",
      "median_window": 2,
      "ema_alpha": 0.85,
      "sign_change_fast_response_enabled": true,
      "sign_change_threshold_w": 50,
      "sign_change_filter_reset_factor": 1.0,
      "ramp_enabled": true,
      "ramp_up_w_per_cycle": 300,
      "ramp_down_w_per_cycle": 500,
      "device_ramp_enabled": true,
      "device_ramp_up_w_per_cycle": 250,
      "device_ramp_down_w_per_cycle": 400,
      "write_cooldown_seconds": 1,
      "large_import_bypass_w": 600,
      "large_export_bypass_w": 500,
      "bypass_ramp_multiplier": 1.5,
      "telemetry_max_age_seconds": 10,
      "stale_telemetry_ramp_factor": 0.5
    },
    "redistribute_clamped_power": true,
    "pv_kwp_weighting": true,
    "pv_charge_balance_enabled": true,
    "pv_charge_balance_deadband_percent": 1,
    "pv_charge_balance_full_bias_percent": 15,
    "pv_charge_balance_strength": 0.7,
    "battery_kwh_weighting": true,
    "soc_reconcile_interval": 10
  },

  "winter": {
    "_comment": "Optional winter SOC strategy. See docs/configuration-examples.md before changing advanced values.",
    "enabled": false,
    "months": [10, 11, 12, 1, 2, 3],
    "summer_min_soc": 15,
    "winter_min_soc": 40,
    "ramp_step_percent": 5,
    "adjust_hour": 12,
    "ac_charge_power": 200
  },

  "_comment_devices": "One entry per Zendure device. IP and SN must match your local device.",
  "devices": [
    {
      "name": "WR1",
      "ip": "192.168.1.100",
      "sn": "YOUR_SN",

      "_comment_smart_mode": "smart_mode=1 is runtime/RAM mode.",
      "smart_mode": 1,
      "max_power": 800,
      "pv_kwp": 1.0,
      "pv_priority_factor": 1.0,
      "battery_kwh": 1.0,

      "_comment_soc": "min_soc/max_soc in percent. Use 0 to leave the value unmanaged.",
      "min_soc": 15,
      "max_soc": 100
    },
    {
      "name": "WR2",
      "ip": "192.168.1.101",
      "sn": "YOUR_SN",

      "_comment_smart_mode": "smart_mode=1 is runtime/RAM mode.",
      "smart_mode": 1,
      "max_power": 800,
      "pv_kwp": 1.0,
      "pv_priority_factor": 1.0,
      "battery_kwh": 1.0,

      "_comment_soc": "min_soc/max_soc in percent. Use 0 to leave the value unmanaged.",
      "min_soc": 15,
      "max_soc": 100
    }
  ],

  "shelly": {
    "_comment": "Shelly device used for household power measurement.",
    "ip": "192.168.1.50"
  }
}
