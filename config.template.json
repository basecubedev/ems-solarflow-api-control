{
  "ha": {
    "enabled": true,
    "control_enabled": true,
    "url": "http://homeassistant.local:8123",
    "token": "YOUR_TOKEN_HERE"
  },

  "system": {
    "enabled": true,
    "dry_run": true,
    "simulation_mode": false,
    "allow_hardware_writes": true,
    "allow_state_reconciliation_writes": true,
    "reconcile_ac_mode_on_start": true,
    "reconcile_smart_mode": true,
    "log_level": "info",
    "max_total_power": 800,
    "max_device_power": 800,
    "deadband": 10,
    "runtime_state_path": "runtime-state.json",
    "min_output_limit": 0,
    "loop_interval": 5,
    "redistribute_clamped_power": true,
    "pv_kwp_weighting": true,
    "battery_kwh_weighting": true,

    "soc_reconcile_interval": 10
  },

  "devices": [
    {
      "name": "WR1",
      "ip": "192.168.1.100",
      "sn": "YOUR_SN",

      "_comment": "smart_mode: 1 = runtime/RAM mode",
      "smart_mode": 1,
      "max_power": 800,
      "pv_kwp": 1.0,
      "pv_priority_factor": 1.0,
      "battery_kwh": 1.0,

      "_comment": "min/max soc = 0 = unmanaged / keep Zendure app settings or no battery",
      "min_soc": 15,
      "max_soc": 100
    },
    {
      "name": "WR2",
      "ip": "192.168.1.101",
      "sn": "YOUR_SN",

      "_comment": "smart_mode: 1 = runtime/RAM mode",
      "smart_mode": 1,
      "max_power": 800,
      "pv_kwp": 1.0,
      "pv_priority_factor": 1.0,
      "battery_kwh": 1.0,

      "_comment": "min/max soc = 0 = unmanaged / keep Zendure app settings or no battery",
      "min_soc": 15,
      "max_soc": 100
    }
  ],

  "shelly": {
    "ip": "192.168.1.50"
  }
}
