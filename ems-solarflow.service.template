[Unit]
Description=EMS Solarflow API Controller
Wants=network-online.target
After=network-online.target

# Prevent restart limits (a [Unit] setting; systemd ignores it under [Service])
StartLimitIntervalSec=0

[Service]
Type=simple

# ===== USER CONFIG =====
# Change this to your system user
User=YOUR_USER

# Path to your project directory
WorkingDirectory=/home/YOUR_USER/ems-solarflow-api-control

# The Python of the project's virtual environment, which holds requests,
# paho-mqtt and cryptography (see docs/native-python.md)
ExecStart=/home/YOUR_USER/ems-solarflow-api-control/.venv/bin/python -B /home/YOUR_USER/ems-solarflow-api-control/ems-solarflow-api-control.py

# ===== BEHAVIOR =====
# Always restart if the script crashes
Restart=always
RestartSec=5

# ===== LOGGING =====
# Send logs to journalctl
StandardOutput=journal
StandardError=journal

# Ensure Python logs are not buffered
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target