[Unit]
Description=EMS SolarFlow Appliance operator configuration
Documentation=file:///usr/share/doc/ems-appliance-manager/architecture.md
# Seeds /etc/ems-appliance-manager from the packaged templates, and only ever
# creates what is absent. It runs on every boot because that is indistinguishable
# from running once: a file that exists is never read, compared or rewritten.
After=local-fs.target
RequiresMountsFor=/etc/ems-appliance-manager
# Every reader of the generated files starts after this writes them. The
# export unit reads host-paths.env and hands the roots it binds to
# backup-access activate; started first on a boot after appliance.conf
# changed, it would bind the old roots and authenticate the account
# against them before the new sshd policy exists. The watcher is held for
# the same reason: the directory it watches comes from the drop-in the
# same apply writes. An ordering edge only -- no Wants or Requires, so a
# seed that fails does not take the exports down with it.
Before=ems-appliance-agent.service ems-appliance-web.service \
       ems-appliance-export.service ems-appliance-export.path

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
ExecStart=/usr/bin/ems-appliance seed-config --quiet
# host-paths.env is derived from the file seeded above, so the image must not
# carry a copy of it. It is written here instead, and only when it stopped
# agreeing -- which on an unchanged appliance is never.
ExecStart=/usr/bin/ems-appliance host-config --apply --if-drifted --quiet
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
