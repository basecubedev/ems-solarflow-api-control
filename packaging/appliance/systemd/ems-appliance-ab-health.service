[Unit]
Description=EMS SolarFlow Appliance A/B trial-boot health verification
Documentation=file:///usr/share/doc/ems-appliance-manager/ab-os-updates.md
ConditionPathExists=/etc/ems-appliance-manager/ab-layout.json
# The health gates inspect the running appliance, so everything they judge has
# to have had its chance to start first.
After=ems-appliance-persistence.service
After=docker.service
After=ems-appliance-agent.service ems-appliance-web.service
# The trial slot judges the runtime the bootstrap reconstructed, so it has to
# have finished. A bootstrap that failed leaves the health gates to report it.
After=ems-appliance-slot-bootstrap.service
Wants=ems-appliance-slot-bootstrap.service
Requires=ems-appliance-persistence.service
# network-online is wanted, never required: an appliance whose WAN is down is
# not a broken slot, and a health check that treated it as one would roll back a
# perfectly healthy update.
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
# The service decides one thing: does this trial slot commit itself. It never
# commits a slot that is not on trial, and a run that cannot prove the pending
# operation leaves the appliance for an operator instead of guessing.
ExecStart=/usr/bin/ems-appliance ab trial-health --commit
# Bounded on purpose: a trial slot must never stay pending indefinitely. This
# has to outlast the settle budget the health check spends waiting for a
# cold-started deployment to answer, or systemd kills the verdict before it is
# reached and a healthy slot is abandoned for being slow.
TimeoutStartSec=600
# A failed health check is a result, not a crash to retry into.
Restart=no

[Install]
WantedBy=multi-user.target
