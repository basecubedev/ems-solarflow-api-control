# SPDX-License-Identifier: AGPL-3.0-or-later
[Unit]
Description=EMS SolarFlow Appliance Manager privileged host agent
Documentation=file:///usr/share/doc/ems-appliance-manager/architecture.md
After=local-fs.target
# The agent reactivates an armed WLAN revert before it binds its socket, and
# `nmcli connection up` against a NetworkManager that is not yet on the bus
# fails. Ordering only: NetworkManager is optional on this host, and systemd
# ignores an ordering against a unit that is not installed.
After=NetworkManager.service
Before=ems-appliance-web.service

[Service]
# Not Type=simple: that reports the unit active as soon as ExecStart is forked,
# which is before the agent has bound its socket. The package's postinst starts
# this unit and then runs `ems-appliance verify-install`, whose socket check
# asks once and fails the whole installation when it comes back empty -- an
# aborted `dpkg` run, seen on a real CI install where the very next check in the
# same run reached the agent through that socket successfully. Type=notify means
# `systemctl restart` returns when the agent says READY=1, which it sends after
# the socket is bound, chmodded and grouped.
Type=notify
# The agent is privileged on purpose: it drives Docker, apt, systemd,
# NetworkManager and authorized_keys. It never accepts a command string and
# only listens on a local Unix socket.
User=root
# The primary group owns the runtime directory and the socket, so the web
# account reaches the agent through group membership and nothing else. It must
# stay identical to the tmpfiles rule for /run/ems-appliance-manager.
Group=ems-appliance
# The generated host-path contract: the same roots the export setup script
# and the verification CLI use. Optional so an unconfigured host still boots.
EnvironmentFile=-/etc/ems-appliance-manager/host-paths.env
ExecStart=/usr/bin/ems-appliance agent
# Longer than anything in the start path. DefaultTimeoutStartSec is 90 s, which
# is exactly nmcli's own wait for `connection up`, so a start that has any
# reason to be slow used to be killed rather than waited for -- and with
# Restart=on-failure the retries landed 93 s apart, which StartLimitBurst in a
# ten-second window never catches.
TimeoutStartSec=300
Restart=on-failure
RestartSec=3
# Everything the agent creates is root-only by default; the socket is chmodded
# to 0660 explicitly because it is the one thing the web account may reach.
UMask=0077
RuntimeDirectory=ems-appliance-manager
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=no

# AF_INET/AF_INET6 are required: the Admin health check runs against the
# loopback address, apt fetches repository metadata and the release index is
# retrieved over HTTPS. With AF_UNIX alone every one of those fails with
# "[Errno 97] Address family not supported by protocol".
# AF_NETLINK is required too: the Repair port inspection runs ss(8), which
# opens a netlink socket. Without it the check cannot run at all.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

# RestrictSUIDSGID is deliberately absent: dpkg restores setuid bits while
# unpacking, and with the restriction a package install aborts with
# "error setting permissions of './usr/bin/chage': Operation not permitted".
ProtectHome=yes
PrivateTmp=yes
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes

[Install]
WantedBy=multi-user.target
