# /var/lib/docker is per-slot, so a freshly written slot has an empty image
# store. This reconstructs the Admin and EMS runtime from the digests recorded
# on the persistent partition before the trial slot is allowed to judge itself.
[Unit]
Description=EMS SolarFlow Appliance slot runtime reconstruction
Documentation=file:///usr/share/doc/ems-appliance-manager/ab-os-updates.md
ConditionPathExists=/etc/ems-appliance-manager/ab-layout.json
Requires=ems-appliance-persistence.service
After=ems-appliance-persistence.service
Requires=docker.service
After=docker.service
# Registry access is wanted, not required: a seeded or already-present image
# must let an offline appliance finish, and a slot that cannot reconstruct
# fails its health check rather than being retried into a rollback loop.
Wants=network-online.target
After=network-online.target
Before=ems-appliance-ab-health.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
ExecStart=/usr/bin/ems-appliance ab slot-bootstrap
TimeoutStartSec=900
Restart=no

[Install]
WantedBy=multi-user.target
