[Unit]
Description=EMS SolarFlow Appliance shared persistent state
Documentation=file:///usr/share/doc/ems-appliance-manager/ab-persistence-contract.md
# The unit ships in every slot but only applies to an A/B image; a single-slot
# appliance keeps its ordinary root filesystem and this never runs there.
#
# Anchored on the slot-local build marker, deliberately not on the layout
# descriptor: that descriptor lives under /etc/ems-appliance-manager, which is
# itself one of the shared binds this unit exists to verify. A skipped bind
# would take the descriptor with it, the condition would read false, and the one
# unit that fails closed would quietly skip -- exactly when it is needed.
ConditionPathExists=/etc/ems-appliance-os-build
# rpi-image-gen mounts /persistent and binds every declared shared path through
# its slot-shared generator. This unit does not mount anything: it proves those
# mounts happened, because upstream's generator guards each bind with
# ConditionPathIsDirectory and therefore fails open. A skipped bind looks
# healthy right up to the next slot switch, which then loses every write.
# By path, not by unit name. ConditionPathExists= above is evaluated when the
# job runs; a literal Requires=persistent.mount is resolved when the transaction
# is built, so on a single-slot host — still a supported installation shape —
# it fails every unit that reaches this one, including the agent's.
# RequiresMountsFor= adds the same Requires= and After= on persistent.mount
# wherever /persistent is a mount point, and resolves to -.mount where it is not.
RequiresMountsFor=/persistent
After=local-fs.target
# Upstream's generator writes one .mount unit per declared path and links
# exactly one of them into local-fs.target, so five of the six binds would
# never be activated. The image ships the missing .wants links, and this
# pulls the same mounts in through systemd's own path dependency, so the
# verification below cannot run before the mounts it is verifying.
RequiresMountsFor=/opt/ems-solarflow /var/lib/ems-appliance-manager
RequiresMountsFor=/var/log/ems-appliance-manager /etc/ems-appliance-manager
RequiresMountsFor=/var/lib/ems-appliance-os-update
RequiresMountsFor=/etc/NetworkManager/system-connections
RequiresMountsFor=/var/lib/ems-backup
Before=ems-appliance-agent.service ems-appliance-web.service
Before=ems-appliance-slot-bootstrap.service ems-appliance-ab-health.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Fail closed. Every unit that could write appliance state Requires= this one,
# so a shared path that fell back to the read-only root stops them instead of
# letting them write somewhere the next slot switch discards.
ExecStart=/usr/bin/ems-appliance ab verify-persistence --quiet
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
