# Compressed swap in memory (zram), half the memory in size, the first place
# the kernel puts pages under pressure. Before Docker, so InfluxDB's start --
# the largest peak on a 1 GB board -- has it.
#
# Anchored on the build marker like the root growth: a .deb installation on
# somebody else's Raspberry Pi OS keeps the swap its owner chose.
[Unit]
Description=EMS SolarFlow Appliance compressed swap (zram)
Documentation=file:///usr/share/doc/ems-appliance-manager/installation.md
ConditionPathExists=/etc/ems-appliance-os-build
After=local-fs.target
Before=docker.service ems-appliance-agent.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/ems-appliance-manager/swap-setup.sh zram

[Install]
WantedBy=multi-user.target
