[Unit]
Description=EMS SolarFlow appliance automatic security updates
Documentation=file:///usr/share/doc/ems-appliance-manager/os-updates.md
# The agent owns every package mutation on this appliance, and this is one of
# its callers rather than a second one: it plans, is blocked by the same
# blockers and leaves the same operation record the console does. Ordered after
# apt-daily as Debian orders apt-daily-upgrade: a run due while apt-daily is
# refreshing waits for it.
After=ems-appliance-agent.service apt-daily.service
Wants=ems-appliance-agent.service

[Service]
Type=oneshot
User=root
EnvironmentFile=-/etc/ems-appliance-manager/host-paths.env
# Does nothing at all unless automatic_security_updates is on in
# appliance.conf, and exits 0 whenever it declines -- a daily timer that leaves
# a failed unit behind because the package manager was busy teaches an operator
# to stop reading it. What happened is in the journal and in the operation
# record either way.
ExecStart=/usr/bin/ems-appliance auto-update
# apt on a Pi 3B+ is slow, and the install unit for the manager package allows
# the same order of magnitude.
# Longer than the plan's own limit (protocol.UPDATE_PLAN_TIMEOUT), the execute
# call and packages.SCHEDULED_INSTALL_WAIT_SECONDS together: the command waits
# for apt to end, and a unit that ran out first failed a daily timer -- or,
# with the agent down, killed dpkg mid-upgrade.
TimeoutStartSec=5400
