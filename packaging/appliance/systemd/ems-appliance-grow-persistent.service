# image-rota sizes the persistent partition at build time; the medium an
# operator imaged it onto is whatever they had. This is the one partition change
# the project makes, and it happens on a freshly imaged appliance before any
# data exists — never on a running installation.
[Unit]
Description=EMS SolarFlow Appliance persistent partition growth
Documentation=file:///usr/share/doc/ems-appliance-manager/ab-persistence-contract.md
ConditionPathExists=/etc/ems-appliance-manager/ab-layout.json
ConditionPathExists=!/persistent/.grown
DefaultDependencies=no
After=persistent.mount
Requires=persistent.mount
Before=ems-appliance-persistence.service local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/ems-appliance ab grow-persistent
TimeoutStartSec=300

[Install]
WantedBy=local-fs.target
