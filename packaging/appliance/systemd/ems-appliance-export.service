[Unit]
Description=EMS SolarFlow appliance read-only SFTP export root
Documentation=file:///usr/share/doc/ems-appliance-manager/ssh-backup-access.md
After=local-fs.target
ConditionPathExists=/usr/lib/ems-appliance-manager/setup-export-root.sh
OnFailure=ems-appliance-backup-access-disable.service

[Service]
Type=oneshot
# No sandboxing directive here on purpose: any of them would give the unit a
# private mount namespace, and the read-only bind mounts it creates would then
# be invisible to sshd.
EnvironmentFile=-/etc/ems-appliance-manager/host-paths.env
# Ownership of an imaged account can only be established once the shared mounts
# are up. Non-fatal on purpose: unresolved ownership is what the activation step
# below already refuses on, and it is no reason to stop exporting.
ExecStartPre=-/usr/lib/ems-appliance-manager/backup-account.sh ensure
ExecStart=/usr/lib/ems-appliance-manager/setup-export-root.sh
# Authentication follows the verified boundary, never the other way round: this
# enables the account only while the exports and the sshd policy check out, and
# disables it otherwise.
ExecStartPost=/usr/bin/ems-appliance backup-access activate

[Install]
WantedBy=multi-user.target
