[Unit]
Description=EMS SolarFlow Appliance Manager web interface
Documentation=file:///usr/share/doc/ems-appliance-manager/architecture.md
After=network.target ems-appliance-agent.service

[Service]
Type=simple
# Unprivileged on purpose: this process has no Docker socket, no root and no
# way to run a host command. It reaches the agent socket through the shared
# ems-appliance group only.
User=ems-appliance-web
Group=ems-appliance
EnvironmentFile=-/etc/ems-appliance-manager/host-paths.env
ExecStart=/usr/bin/ems-appliance web
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
# Only the web-owned subtree is writable. Agent state, agent logs and the
# audit log are root-only on disk and additionally made invisible here, so a
# flaw in this process cannot read an operation record or a confirmation token.
ReadWritePaths=/var/lib/ems-appliance-manager/web /var/log/ems-appliance-manager/web
InaccessiblePaths=-/var/lib/ems-appliance-manager/agent -/var/log/ems-appliance-manager/agent -/var/log/ems-appliance-manager/audit
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @obsolete

[Install]
WantedBy=multi-user.target
