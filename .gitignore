# local AI / research docs
/docs/develop/
/CODEX_AGENT_GUIDE.md
/tasks/

# local Claude Code project files
/CLAUDE.md
/CLAUDE.local.md
/.claude/



# runtime traces
runtime-traces/
runtime-state.json
runtime-state.json.tmp
runtime-state.json.*.tmp

# local config (the versioned template stays tracked)
/config.json
/config/*
!/config/config.template.json

# Docker-first enduser .env (PUID/PGID, COMPOSE_PROFILES)
/.env

# Guided-upgrade pre-update backup of the compose file
/docker-compose.yml.bak

# logs
*.log
*.influx.csv
*.influx.jsonl

# local generated reports. Two bounded sets are committed on purpose: the
# appliance release evidence, and the dashboard performance baselines a change
# has to be compared against. Nothing else here is.
/reports/*
!/reports/appliance/
!/reports/dashboard-perf/

# Manual config/runtime backups (may contain secrets)
/backup/
/backup/**

# Dashboard local SQLite history and Admin runtime cache
/data/*
!/data/admin/
/data/admin/*
!/data/admin/.gitkeep
*.sqlite-wal
*.sqlite-shm

# InfluxDB official deployment (secrets / local state)
/deploy/docker/influxdb.env
/deploy/docker/data/

# InfluxDB local development
/develop/influxdb/.env
/develop/influxdb/data/
/develop/influxdb/data/**
/develop/influxdb/exports/
/develop/influxdb/exports/**
/develop/influxdb/.influxdbv2/
/develop/influxdb/tmp/
/develop/influxdb/*.sqlite
/develop/influxdb/*.bolt

# Grafana local development
/develop/grafana/.env
/develop/grafana/data/
/develop/grafana/data/**

# Process core dumps. A dump carries whatever the crashed process held in
# memory, so it must never reach a commit, a push or a release bundle.
# scripts/check_repository_hygiene.py rejects one that gets tracked anyway.
core
core.*
*.core

# Python cache artifacts
__pycache__/
.pytest_cache/
*.py[cod]
*$py.class


# Playwright end-to-end tests
node_modules/
test-results/
playwright-report/
blob-report/
.playwright/

# Appliance package build output (packaging/appliance/build-deb.sh)
/dist/
